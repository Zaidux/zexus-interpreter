#!/usr/bin/env node
// Zexus unified launcher (Phase I consolidation).
//
// One structure, two public commands:
//   zx  <args>   → python3 -m zexus <args>        (run/repl/check/…)
//   zxpm <args>  → python3 -m zexus.cli.zpm <args> (package manager)
//
// Historical launchers (zexus, zx-run, zx-dev, zx-deploy, zpics) are all
// this same wrapper — they invoked five Python modules, three of which
// never existed (runner/dev/deploy). `zexus` remains an alias of `zx`;
// the rest were dead. `zpics` maps to the testing.pics module via the
// zx entry (`zx pics …`) for anyone who still wants snapshot testing.

const target = process.argv[2] === undefined ? '' : '';

function spawnZexus(module, args) {
  const { spawn } = require('child_process');
  const proc = spawn('python3', ['-m', module, ...args], { stdio: 'inherit' });
  proc.on('error', (err) => {
    if (err.code === 'ENOENT') {
      console.error('Error: python3 not found. Please install Python 3.10+ to use Zexus.');
      process.exit(1);
    }
    console.error('Error:', err.message);
    process.exit(1);
  });
  proc.on('close', (code) => process.exit(code ?? 1));
}

const self = require('path').basename(process.argv[1] || 'zx');
const args = process.argv.slice(2);

if (self === 'zxpm') {
  // Package manager: standalone Click group at zexus.cli.zpm
  spawnZexus('zexus.cli.zpm', args);
} else {
  // Canonical entry: the full CLI (run, repl, check, compile, validate,
  // ast, tokens, init, debug, profile, kernel, pics, zpm passthrough).
  spawnZexus('zexus', args);
}
