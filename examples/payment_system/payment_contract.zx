// ============================================================================
// PAYMENT SMART CONTRACT - Secure Payment Processing System
// ============================================================================
// This contract handles:
// - Token issuance and management
// - Payment processing with escrow
// - Multi-signature authorization for large transactions
// - Rate limiting and fraud detection
// - Refund processing
// ============================================================================

print("=" * 70)
print("💳 PAYMENT SMART CONTRACT - Deployment")
print("=" * 70)

// ============================================================================
// Payment Token Contract
// ============================================================================
contract PaymentToken {
    let balances = {}
    let total_supply = 0
    let owner = ""
    let frozen_accounts = {}
    let transaction_log = []
    let nonces = {}
    let daily_limits = {}
    let daily_spent = {}

    action init(supply, contract_owner) {
        total_supply = supply
        owner = contract_owner
        balances[contract_owner] = supply
        nonces[contract_owner] = 0
        daily_limits[contract_owner] = 100000
        daily_spent[contract_owner] = 0
        print("  💰 PaymentToken initialized")
        print("  Total supply:", supply)
        print("  Owner:", contract_owner)
        return true
    }

    action get_balance(account) {
        let bal = balances[account]
        if bal == null {
            return 0
        }
        return bal
    }

    action get_nonce(account) {
        let n = nonces[account]
        if n == null {
            return 0
        }
        return n
    }

    action is_frozen(account) {
        let f = frozen_accounts[account]
        if f == null {
            return false
        }
        return f
    }

    action freeze_account(account, caller) {
        if caller != owner {
            print("  ❌ Only owner can freeze accounts")
            return false
        }
        frozen_accounts[account] = true
        print("  🔒 Account frozen:", account)
        return true
    }

    action unfreeze_account(account, caller) {
        if caller != owner {
            print("  ❌ Only owner can unfreeze accounts")
            return false
        }
        frozen_accounts[account] = false
        print("  🔓 Account unfrozen:", account)
        return true
    }

    action set_daily_limit(account, limit, caller) {
        if caller != owner {
            if caller != account {
                print("  ❌ Only owner or account holder can set limits")
                return false
            }
        }
        daily_limits[account] = limit
        print("  📊 Daily limit set for", account, ":", limit)
        return true
    }

    action transfer(from_addr, to_addr, amount, provided_nonce) {
        // Validate inputs
        if amount <= 0 {
            print("  ❌ Amount must be positive")
            return false
        }

        if from_addr == to_addr {
            print("  ❌ Cannot transfer to self")
            return false
        }

        // Check frozen status
        let from_frozen = frozen_accounts[from_addr]
        if from_frozen == true {
            print("  ❌ Sender account is frozen:", from_addr)
            return false
        }

        let to_frozen = frozen_accounts[to_addr]
        if to_frozen == true {
            print("  ❌ Recipient account is frozen:", to_addr)
            return false
        }

        // Nonce validation - prevent replay attacks
        let expected_nonce = nonces[from_addr]
        if expected_nonce == null {
            expected_nonce = 0
        }
        if provided_nonce != expected_nonce {
            print("  ❌ Invalid nonce: expected", expected_nonce, "got", provided_nonce)
            return false
        }

        // Balance check
        let from_balance = balances[from_addr]
        if from_balance == null {
            from_balance = 0
        }
        if from_balance < amount {
            print("  ❌ Insufficient balance:", from_balance, "<", amount)
            return false
        }

        // Daily limit check
        let limit = daily_limits[from_addr]
        if limit == null {
            limit = 10000
        }
        let spent = daily_spent[from_addr]
        if spent == null {
            spent = 0
        }
        if spent + amount > limit {
            print("  ❌ Daily limit exceeded:", spent, "+", amount, ">", limit)
            return false
        }

        // Execute transfer
        balances[from_addr] = from_balance - amount

        let to_balance = balances[to_addr]
        if to_balance == null {
            to_balance = 0
        }
        balances[to_addr] = to_balance + amount

        // Update nonce
        nonces[from_addr] = expected_nonce + 1

        // Update daily spent
        daily_spent[from_addr] = spent + amount

        // Log transaction
        let tx_record = {
            "from": from_addr,
            "to": to_addr,
            "amount": amount,
            "nonce": provided_nonce
        }
        transaction_log = transaction_log + [tx_record]

        print("  ✅ Transfer:", from_addr, "→", to_addr, "=", amount, "tokens")
        return true
    }

    action get_transaction_count() {
        return len(transaction_log)
    }
}

// ============================================================================
// Escrow Contract - Holds funds until conditions are met
// ============================================================================
contract EscrowContract {
    let escrows = {}
    let escrow_count = 0
    let token = null

    action init(payment_token) {
        token = payment_token
        print("  🔐 EscrowContract initialized")
        return true
    }

    action create_escrow(buyer, seller, amount, buyer_nonce) {
        // Transfer funds from buyer to escrow
        let success = token.transfer(buyer, "escrow_vault", amount, buyer_nonce)
        if success != true {
            print("  ❌ Failed to fund escrow")
            return null
        }

        let escrow_id = "ESC_" + string(escrow_count)
        escrow_count = escrow_count + 1

        escrows[escrow_id] = {
            "buyer": buyer,
            "seller": seller,
            "amount": amount,
            "status": "pending",
            "dispute": false
        }

        print("  🔐 Escrow created:", escrow_id, "amount:", amount)
        return escrow_id
    }

    action release_escrow(escrow_id, caller) {
        let escrow = escrows[escrow_id]
        if escrow == null {
            print("  ❌ Escrow not found:", escrow_id)
            return false
        }

        if escrow["status"] != "pending" {
            print("  ❌ Escrow already", escrow["status"])
            return false
        }

        // Only buyer can release escrow
        if caller != escrow["buyer"] {
            print("  ❌ Only buyer can release escrow")
            return false
        }

        // Transfer from escrow vault to seller
        let vault_nonce = token.get_nonce("escrow_vault")
        let success = token.transfer("escrow_vault", escrow["seller"], escrow["amount"], vault_nonce)
        if success != true {
            print("  ❌ Failed to release escrow funds")
            return false
        }

        escrow["status"] = "released"
        escrows[escrow_id] = escrow
        print("  ✅ Escrow released:", escrow_id, "→", escrow["seller"])
        return true
    }

    action refund_escrow(escrow_id, caller) {
        let escrow = escrows[escrow_id]
        if escrow == null {
            print("  ❌ Escrow not found:", escrow_id)
            return false
        }

        if escrow["status"] != "pending" {
            print("  ❌ Escrow already", escrow["status"])
            return false
        }

        // Only seller or dispute resolution can refund
        if caller != escrow["seller"] {
            print("  ❌ Only seller can issue refund")
            return false
        }

        // Transfer from escrow vault back to buyer
        let vault_nonce = token.get_nonce("escrow_vault")
        let success = token.transfer("escrow_vault", escrow["buyer"], escrow["amount"], vault_nonce)
        if success != true {
            print("  ❌ Failed to refund escrow")
            return false
        }

        escrow["status"] = "refunded"
        escrows[escrow_id] = escrow
        print("  ✅ Escrow refunded:", escrow_id, "→", escrow["buyer"])
        return true
    }

    action get_escrow(escrow_id) {
        return escrows[escrow_id]
    }
}

// ============================================================================
// Deploy contracts
// ============================================================================
print("\n📦 Deploying Contracts...")

let payment = PaymentToken()
payment.init(1000000, "admin")

let escrow = EscrowContract()
escrow.init(payment)

print("\n✅ Contracts deployed successfully")
print("=" * 70)
