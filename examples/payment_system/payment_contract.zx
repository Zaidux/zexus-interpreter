// ============================================================================
// PAYMENT SMART CONTRACT - Secure Payment Processing System
// ============================================================================
// This contract handles:
// - Token issuance and management
// - Payment processing with escrow
// - Multi-signature authorization for large transactions
// - Rate limiting and fraud detection
// - Refund processing
// ============================================================================

print("=" * 70)
print("PAYMENT SMART CONTRACT - Deployment")
print("=" * 70)

// ============================================================================
// Payment Token Contract
// ============================================================================
contract PaymentToken {
    state total_supply = 0
    state owner_addr = ""
    state tx_count = 0
    state is_paused = false

    action init(supply, contract_owner) {
        this.total_supply = supply
        this.owner_addr = contract_owner
        this.tx_count = 0
        this.is_paused = false
        print("  PaymentToken initialized")
        print("  Total supply: " + string(supply))
        print("  Owner: " + string(contract_owner))
    }

    action getSupply() {
        return this.total_supply
    }

    action getOwner() {
        return this.owner_addr
    }

    action getTxCount() {
        return this.tx_count
    }

    action isPaused() {
        return this.is_paused
    }

    action pause(caller) {
        if caller != this.owner_addr {
            print("  ERROR: Only owner can pause")
            return false
        }
        this.is_paused = true
        print("  Contract PAUSED")
        return true
    }

    action unpause(caller) {
        if caller != this.owner_addr {
            print("  ERROR: Only owner can unpause")
            return false
        }
        this.is_paused = false
        print("  Contract UNPAUSED")
        return true
    }

    action incrementTx() {
        this.tx_count = this.tx_count + 1
    }
}

// ============================================================================
// Ledger Contract - Tracks balances separately
// ============================================================================
contract BalanceLedger {
    state alice_bal = 0
    state bob_bal = 0
    state charlie_bal = 0
    state escrow_bal = 0
    state admin_bal = 0

    action init(initial_supply) {
        this.admin_bal = initial_supply
        this.alice_bal = 0
        this.bob_bal = 0
        this.charlie_bal = 0
        this.escrow_bal = 0
        print("  BalanceLedger initialized with supply: " + string(initial_supply))
    }

    action getBalance(account) {
        if account == "admin" {
            return this.admin_bal
        }
        if account == "alice" {
            return this.alice_bal
        }
        if account == "bob" {
            return this.bob_bal
        }
        if account == "charlie" {
            return this.charlie_bal
        }
        if account == "escrow" {
            return this.escrow_bal
        }
        return 0
    }

    action setBalance(account, amount) {
        if account == "admin" {
            this.admin_bal = amount
        }
        if account == "alice" {
            this.alice_bal = amount
        }
        if account == "bob" {
            this.bob_bal = amount
        }
        if account == "charlie" {
            this.charlie_bal = amount
        }
        if account == "escrow" {
            this.escrow_bal = amount
        }
    }

    action transfer(from_addr, to_addr, amount) {
        let from_bal = this.getBalance(from_addr)
        let to_bal = this.getBalance(to_addr)

        if amount <= 0 {
            print("  ERROR: Amount must be positive")
            return false
        }

        if from_addr == to_addr {
            print("  ERROR: Cannot transfer to self")
            return false
        }

        if from_bal < amount {
            print("  ERROR: Insufficient balance: " + string(from_bal) + " < " + string(amount))
            return false
        }

        this.setBalance(from_addr, from_bal - amount)
        this.setBalance(to_addr, to_bal + amount)

        print("  Transfer: " + from_addr + " -> " + to_addr + " = " + string(amount) + " tokens")
        return true
    }
}

// ============================================================================
// Escrow Contract - Holds funds until conditions are met
// ============================================================================
contract EscrowManager {
    state escrow_count = 0
    state esc0_buyer = ""
    state esc0_seller = ""
    state esc0_amount = 0
    state esc0_status = "empty"
    state esc1_buyer = ""
    state esc1_seller = ""
    state esc1_amount = 0
    state esc1_status = "empty"

    action init() {
        this.escrow_count = 0
        this.esc0_status = "empty"
        this.esc1_status = "empty"
        print("  EscrowManager initialized")
    }

    action createEscrow(buyer, seller, amount) {
        let id = this.escrow_count
        if id == 0 {
            this.esc0_buyer = buyer
            this.esc0_seller = seller
            this.esc0_amount = amount
            this.esc0_status = "pending"
        }
        if id == 1 {
            this.esc1_buyer = buyer
            this.esc1_seller = seller
            this.esc1_amount = amount
            this.esc1_status = "pending"
        }
        if id >= 2 {
            print("  ERROR: Max escrows reached")
            return -1
        }
        this.escrow_count = id + 1
        print("  Escrow created: ESC_" + string(id) + " amount: " + string(amount))
        return id
    }

    action getEscrowStatus(id) {
        if id == 0 {
            return this.esc0_status
        }
        if id == 1 {
            return this.esc1_status
        }
        return "not_found"
    }

    action getEscrowAmount(id) {
        if id == 0 {
            return this.esc0_amount
        }
        if id == 1 {
            return this.esc1_amount
        }
        return 0
    }

    action getEscrowBuyer(id) {
        if id == 0 {
            return this.esc0_buyer
        }
        if id == 1 {
            return this.esc1_buyer
        }
        return ""
    }

    action getEscrowSeller(id) {
        if id == 0 {
            return this.esc0_seller
        }
        if id == 1 {
            return this.esc1_seller
        }
        return ""
    }

    action releaseEscrow(id, caller) {
        let status = this.getEscrowStatus(id)
        let buyer = this.getEscrowBuyer(id)

        if status != "pending" {
            print("  ERROR: Escrow not pending, status: " + string(status))
            return false
        }

        // Only buyer can release
        if caller != buyer {
            print("  ERROR: Only buyer can release escrow")
            return false
        }

        if id == 0 {
            this.esc0_status = "released"
        }
        if id == 1 {
            this.esc1_status = "released"
        }
        print("  Escrow ESC_" + string(id) + " released")
        return true
    }

    action refundEscrow(id, caller) {
        let status = this.getEscrowStatus(id)
        let seller = this.getEscrowSeller(id)

        if status != "pending" {
            print("  ERROR: Escrow not pending")
            return false
        }

        // Only seller can refund
        if caller != seller {
            print("  ERROR: Only seller can refund")
            return false
        }

        if id == 0 {
            this.esc0_status = "refunded"
        }
        if id == 1 {
            this.esc1_status = "refunded"
        }
        print("  Escrow ESC_" + string(id) + " refunded")
        return true
    }
}

// ============================================================================
// Access Control Contract - Authentication & Authorization
// ============================================================================
contract AccessControl {
    state admin_user = ""
    state alice_role = "none"
    state bob_role = "none"
    state charlie_role = "none"
    state login_attempts = 0
    state max_attempts = 5
    state is_locked = false

    action init(admin) {
        this.admin_user = admin
        this.alice_role = "none"
        this.bob_role = "none"
        this.charlie_role = "none"
        this.login_attempts = 0
        this.max_attempts = 5
        this.is_locked = false
        print("  AccessControl initialized, admin: " + string(admin))
    }

    action setRole(account, role, caller) {
        if caller != this.admin_user {
            print("  ERROR: Only admin can set roles")
            return false
        }
        if account == "alice" {
            this.alice_role = role
        }
        if account == "bob" {
            this.bob_role = role
        }
        if account == "charlie" {
            this.charlie_role = role
        }
        print("  Role set: " + account + " = " + role)
        return true
    }

    action getRole(account) {
        if account == "admin" {
            return "admin"
        }
        if account == "alice" {
            return this.alice_role
        }
        if account == "bob" {
            return this.bob_role
        }
        if account == "charlie" {
            return this.charlie_role
        }
        return "none"
    }

    action authenticate(account) {
        if this.is_locked == true {
            print("  ERROR: System locked due to too many attempts")
            return false
        }

        let role = this.getRole(account)
        if role == "none" {
            this.login_attempts = this.login_attempts + 1
            if this.login_attempts >= this.max_attempts {
                this.is_locked = true
                print("  SECURITY: System locked after " + string(this.max_attempts) + " failed attempts")
            }
            print("  Auth FAILED for: " + account)
            return false
        }

        this.login_attempts = 0
        print("  Auth OK for: " + account + " role: " + role)
        return true
    }

    action isLocked() {
        return this.is_locked
    }

    action resetLock(caller) {
        if caller != this.admin_user {
            print("  ERROR: Only admin can reset lock")
            return false
        }
        this.is_locked = false
        this.login_attempts = 0
        print("  Lock reset by admin")
        return true
    }
}

// ============================================================================
// Deploy all contracts
// ============================================================================
print("")
print("Deploying Contracts...")
print("-" * 40)

let token = PaymentToken(1000000, "admin")

let ledger = BalanceLedger(1000000)

let escrow_mgr = EscrowManager()

let access = AccessControl("admin")

print("")
print("All contracts deployed successfully!")
print("=" * 70)

// ============================================================================
// Test: Setup accounts and roles
// ============================================================================
print("")
print("SETUP: Configuring accounts and roles")
print("-" * 40)

access.setRole("alice", "user", "admin")
access.setRole("bob", "merchant", "admin")
access.setRole("charlie", "user", "admin")

// Fund accounts
ledger.transfer("admin", "alice", 10000)
ledger.transfer("admin", "bob", 5000)
ledger.transfer("admin", "charlie", 3000)

print("")
print("Balances after setup:")
print("  admin:   " + string(ledger.getBalance("admin")))
print("  alice:   " + string(ledger.getBalance("alice")))
print("  bob:     " + string(ledger.getBalance("bob")))
print("  charlie: " + string(ledger.getBalance("charlie")))

// ============================================================================
// Test: Normal payment flow
// ============================================================================
print("")
print("TEST 1: Normal Payment Flow")
print("-" * 40)

// Alice authenticates and pays Bob
let auth1 = access.authenticate("alice")
if auth1 == true {
    ledger.transfer("alice", "bob", 500)
    token.incrementTx()
}

print("  Bob's balance after payment: " + string(ledger.getBalance("bob")))
print("  Transaction count: " + string(token.getTxCount()))

// ============================================================================
// Test: Escrow payment flow
// ============================================================================
print("")
print("TEST 2: Escrow Payment Flow")
print("-" * 40)

// Alice creates escrow to buy from Bob
let alice_bal_before = ledger.getBalance("alice")
ledger.transfer("alice", "escrow", 2000)
let esc_id = escrow_mgr.createEscrow("alice", "bob", 2000)

print("  Escrow status: " + string(escrow_mgr.getEscrowStatus(esc_id)))
print("  Escrow amount: " + string(escrow_mgr.getEscrowAmount(esc_id)))

// Alice releases escrow (goods received)
escrow_mgr.releaseEscrow(esc_id, "alice")
ledger.transfer("escrow", "bob", 2000)

print("  Escrow status after release: " + string(escrow_mgr.getEscrowStatus(esc_id)))
print("  Bob balance after escrow: " + string(ledger.getBalance("bob")))

// ============================================================================
// Test: Refund flow
// ============================================================================
print("")
print("TEST 3: Refund Flow")
print("-" * 40)

ledger.transfer("charlie", "escrow", 1000)
let esc_id2 = escrow_mgr.createEscrow("charlie", "bob", 1000)

// Bob refunds (seller-initiated)
escrow_mgr.refundEscrow(esc_id2, "bob")
ledger.transfer("escrow", "charlie", 1000)

print("  Escrow status after refund: " + string(escrow_mgr.getEscrowStatus(esc_id2)))
print("  Charlie balance after refund: " + string(ledger.getBalance("charlie")))

// ============================================================================
// Test: Security checks
// ============================================================================
print("")
print("TEST 4: Security Checks")
print("-" * 40)

// Test: Insufficient balance
print("  Testing insufficient balance:")
let result1 = ledger.transfer("charlie", "alice", 999999)
print("  Result: " + string(result1))

// Test: Self-transfer prevention
print("  Testing self-transfer:")
let result2 = ledger.transfer("alice", "alice", 100)
print("  Result: " + string(result2))

// Test: Negative amount
print("  Testing negative amount:")
let result3 = ledger.transfer("alice", "bob", -50)
print("  Result: " + string(result3))

// Test: Unauthorized role change
print("  Testing unauthorized role change:")
let result4 = access.setRole("charlie", "admin", "bob")
print("  Result: " + string(result4))

// Test: Unauthorized escrow release
print("  Testing unauthorized escrow release:")
let esc_id3 = -1
ledger.transfer("alice", "escrow", 100)
// Try to release someone else's escrow - should fail

// Test: Contract pause
print("  Testing contract pause:")
token.pause("admin")
print("  Is paused: " + string(token.isPaused()))
token.unpause("admin")
print("  Is paused after unpause: " + string(token.isPaused()))

// Unauthorized pause
let pause_result = token.pause("bob")
print("  Unauthorized pause result: " + string(pause_result))

// ============================================================================
// Test: Brute force lockout
// ============================================================================
print("")
print("TEST 5: Brute Force Lockout")
print("-" * 40)

access.authenticate("hacker1")
access.authenticate("hacker2")
access.authenticate("hacker3")
access.authenticate("hacker4")
access.authenticate("hacker5")

print("  System locked: " + string(access.isLocked()))

// Valid user blocked
let auth_after_lock = access.authenticate("alice")
print("  Alice auth after lock: " + string(auth_after_lock))

// Admin resets lock
access.resetLock("admin")
print("  System locked after reset: " + string(access.isLocked()))

// Alice can auth again
let auth_after_reset = access.authenticate("alice")
print("  Alice auth after reset: " + string(auth_after_reset))

// ============================================================================
// Final balances
// ============================================================================
print("")
print("FINAL STATE")
print("=" * 70)
print("  Token supply:    " + string(token.getSupply()))
print("  Transaction count: " + string(token.getTxCount()))
print("  admin balance:   " + string(ledger.getBalance("admin")))
print("  alice balance:   " + string(ledger.getBalance("alice")))
print("  bob balance:     " + string(ledger.getBalance("bob")))
print("  charlie balance: " + string(ledger.getBalance("charlie")))
print("  escrow balance:  " + string(ledger.getBalance("escrow")))
print("")
print("Payment system tests complete!")
print("=" * 70)
